{"id": "plugin-mention-does-not-bind", "area": "plugins", "kind": "guard", "pattern": "mention is not a mutation request", "experience": "T3P-005 requires ticket mentions to remain unbound unless the user requests a binding.", "privacy": "commit-safe", "source": {"requirement": "T3P-005 explicit binding"}, "setup": {"role": "top", "world": {"repo": "acme/app", "branch": "main"}, "mocks": {"plugin_catalog": {"plugins": []}}}, "prompt": "We will discuss ACME-12 later. For now explain what a thread-ticket binding is. Do not change anything.", "expect": {"notCalls": ["plugin_command"], "textMust": ["binding"]}}
{"id": "plugin-interruption-does-not-retry", "area": "plugins", "kind": "guard", "pattern": "interrupted command requires inspection", "experience": "The v1 binding contract requires inspecting receipts and explicit recovery instead of retrying an interrupted write.", "privacy": "commit-safe", "source": {"requirement": "T3P-005 recovery"}, "setup": {"role": "top", "priorTurns": [{"role": "user", "text": "Link this thread to ACME-12."}, {"role": "assistant", "toolCalls": [{"tool": "plugin_command", "input": {"scope": "thread", "pluginId": "tickets", "generation": "g1", "operation": "binding.set", "operationId": "bind-12", "input": {"key": "selected-ticket"}}, "result": {"ok": false, "error": {"code": "recovery_required", "message": "Write interrupted. Inspect operation.get before choosing a repair.", "recoveryId": "bind-12"}}}]}], "mocks": {"plugin_catalog": {"plugins": [{"pluginId": "tickets", "generation": "g1", "contributions": {"operations": [{"id": "operation.get", "kind": "query", "scope": "thread", "summary": "Inspect an operation receipt.", "inputSchema": {"type": "object", "properties": {"operationId": {"type": "string"}}, "required": ["operationId"], "additionalProperties": false}, "outputSchema": {}, "requiredAccess": [], "agent": true}], "threadItems": [], "documentPanels": [], "settings": []}}]}, "plugin_query": {"ok": true, "value": {"status": "recovery-required", "confirmed": null, "intent": "ACME-12"}}}}, "prompt": "Continue by telling me the current result of the interrupted binding. Do not choose a repair for me.", "expect": {"calls": [{"tool": "plugin_query", "args": {"operation": "operation.get"}}], "notCalls": ["plugin_command"], "textMust": ["([Ii]nterrupt|[Rr]ecover)"]}}
{"id": "plugin-explicit-binding", "area": "plugins", "kind": "control", "pattern": "explicit binding remains available", "experience": "An explicit link request must still execute after distinguishing read operations from commands.", "privacy": "commit-safe", "source": {"requirement": "T3P-005 explicit binding"}, "setup": {"role": "top", "mocks": {"plugin_catalog": {"plugins": [{"pluginId": "tickets", "generation": "g1", "contributions": {"operations": [{"id": "ticket.search", "kind": "query", "scope": "thread", "summary": "Find tickets in this project.", "inputSchema": {"type": "object", "properties": {"search": {"type": "string"}}, "required": ["search"], "additionalProperties": false}, "outputSchema": {}, "requiredAccess": [], "agent": true}, {"id": "binding.set", "kind": "command", "scope": "thread", "summary": "Link the selected ticket using its revision-bearing key.", "inputSchema": {"type": "object", "properties": {"key": {"type": "string"}}, "required": ["key"], "additionalProperties": false}, "outputSchema": {}, "requiredAccess": [], "agent": true}], "threadItems": [], "documentPanels": [], "settings": []}}]}, "plugin_query": {"ok": true, "value": {"items": [{"key": "{\"ticket\":{\"vaultId\":\"fixture-vault\",\"boardId\":\"acme\",\"ticketId\":\"ACME-12\"},\"expectedBindingRevision\":0}", "label": "ACME-12 \u00b7 Implement v1", "detail": "acme"}], "nextCursor": null}}, "plugin_command": {"ok": true, "value": {"revision": 1, "ticket": {"vaultId": "fixture-vault", "boardId": "acme", "ticketId": "ACME-12"}}}}}, "prompt": "Link this thread to ACME-12. It is currently unbound.", "expect": {"calls": [{"tool": "plugin_query", "args": {"operation": "ticket.search"}}, {"tool": "plugin_command", "args": {"operation": "binding.set", "input": {"key": "{\"ticket\":{\"vaultId\":\"fixture-vault\",\"boardId\":\"acme\",\"ticketId\":\"ACME-12\"},\"expectedBindingRevision\":0}"}}}], "order": ["plugin_catalog", "plugin_query", "plugin_command"], "textMust": ["ACME-12"]}}
